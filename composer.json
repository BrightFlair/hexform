{
	"name": "brightflair/hexform",
	"description": "A minimal PHP.GT WebEngine homepage.",
	"require": {
		"php": ">=8.4",
		"phpgt/webengine": "^5.0",
		"authwave/php-client": "dev-master"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.4",
		"phpstan/phpstan": "^2.2",
		"squizlabs/php_codesniffer": "^4.0",
		"phpmd/phpmd": "^2.15",
		"behat/behat": "^3.15",
		"friends-of-behat/mink-extension": "^2.7",
		"behat/mink-selenium2-driver": "^1.7",
		"behat/mink": "^1.13",
		"dmore/chrome-mink-driver": "^2.9",
		"dmore/behat-chrome-extension": "^1.4"
	},
	"autoload": {
		"psr-4": {
			"HexForm\\": "./class"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"HexForm\\Test\\": "./test/phpunit"
		}
	},
	"scripts": {
		"behat": "test/behat/start-behat",
		"phpunit": "vendor/bin/phpunit -c phpunit.xml",
		"phpstan": "vendor/bin/phpstan analyse --level 6 class",
		"phpcs": "vendor/bin/phpcs class/ --standard=phpcs.xml",
		"phpmd": "vendor/bin/phpmd class/ text phpmd.xml",
		"test": [
			"@behat",
			"@phpunit",
			"@phpcs",
			"@phpmd",
			"@phpstan"
		]
	}
}
